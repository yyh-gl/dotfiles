{
  "respectGitignore": false,
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_DISABLE_MOUSE_CLICKS": "1",
    "CLAUDE_AFK_TIMEOUT_MS": "3600000",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "1",
    "CLAUDE_CODE_PLUGIN_DIRS": "~/.claude/mods/statusline:~/.claude/mods/prompt-highlight-md"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "fallbackModel": [
    "opus",
    "sonnet"
  ],
  "advisorModel": "opus",
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      }
    }
  },
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run typecheck)",
      "Bash(npm run test:*)",
      "Bash(pnpm run lint)",
      "Bash(pnpm run typecheck)",
      "Bash(pnpm run test:*)",
      "Bash(git add:*)",
      "Bash(git mv:*)",
      "Bash(git commit*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh search:*)",
      "Bash(gh repo view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh release list:*)",
      "Bash(gh release view:*)",
      "Bash(docker ps:*)",
      "Bash(docker images:*)",
      "Bash(docker info:*)",
      "Bash(docker version:*)",
      "Bash(docker compose ps:*)",
      "Bash(docker compose logs:*)",
      "Bash(docker system df:*)",
      "mcp__codex__codex",
      "mcp__codex__codex-reply",
      "mcp__ide__getDiagnostics",
      "mcp__idea__get_file_text_by_path",
      "mcp__idea__search_in_files_by_text",
      "mcp__idea__search_in_files_by_regex",
      "mcp__idea__list_directory_tree",
      "mcp__idea__get_file_problems",
      "mcp__idea__find_files_by_name_keyword",
      "mcp__idea__find_files_by_glob",
      "mcp__idea__search_file",
      "mcp__idea__get_run_configurations",
      "mcp__idea__get_project_modules",
      "mcp__idea__get_project_dependencies",
      "mcp__idea__get_symbol_info",
      "mcp__idea__get_all_open_file_paths",
      "WebFetch(domain:tech.yyh-gl.dev)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:code.claude.com)",
      "WebFetch(domain:docs.claude.com)",
      "WebFetch(domain:platform.claude.com)",
      "WebFetch(domain:claude.com)",
      "WebFetch(domain:kotlinlang.org)",
      "WebFetch(domain:wezterm.org)",
      "WebFetch(domain:ghostty.org)",
      "WebFetch(domain:json.schemastore.org)",
      "WebFetch(domain:www.schemastore.org)",
      "WebFetch(domain:kabutan.jp)",
      "WebFetch(domain:irbank.net)",
      "Read(~/.zshrc)",
      "Read(~/.claude/skills/**)",
      "Read(~/.claude/agents/**)"
    ],
    "deny": [
      "Bash(git push*)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.*.local)",
      "Read(.env.production)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.test)",
      "Read(**/secrets/**)",
      "Read(**/credentials/**)",
      "Read(**/terraform.tfvars)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(~/.aws/credentials)",
      "Read(~/.kube/config)",
      "Read(~/.local/share/deck/credentials.json)",
      "Read(~/.ssh/**)",
      "Read(~/.config/gh/hosts.yml)"
    ],
    "ask": [
      "Bash(git rm*)",
      "Bash(gh pr create*)",
      "Bash(gh pr merge*)",
      "Bash(gh pr close*)",
      "Bash(gh pr edit*)",
      "Bash(gh issue create*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue close*)",
      "Bash(gh repo create*)",
      "Bash(gh repo delete*)",
      "Bash(gh release create*)",
      "Bash(gh workflow run*)",
      "Bash(gh secret *)",
      "Bash(gh api *)",
      "Bash(gh gist*)",
      "Bash(docker run *)",
      "Bash(docker exec *)",
      "Bash(docker cp *)",
      "Bash(docker build *)",
      "Bash(docker buildx *)",
      "Bash(docker builder *)",
      "Bash(docker create *)",
      "Bash(docker start *)",
      "Bash(docker restart *)",
      "Bash(docker stop *)",
      "Bash(docker kill *)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker update *)",
      "Bash(docker commit *)",
      "Bash(docker pull *)",
      "Bash(docker push *)",
      "Bash(docker login *)",
      "Bash(docker tag *)",
      "Bash(docker save *)",
      "Bash(docker load *)",
      "Bash(docker import *)",
      "Bash(docker export *)",
      "Bash(docker container *)",
      "Bash(docker image *)",
      "Bash(docker volume *)",
      "Bash(docker network *)",
      "Bash(docker plugin *)",
      "Bash(docker context *)",
      "Bash(docker system prune *)",
      "Bash(docker compose up *)",
      "Bash(docker compose down *)",
      "Bash(docker compose run *)",
      "Bash(docker compose exec *)",
      "Bash(docker compose cp *)",
      "Bash(docker compose build *)",
      "Bash(docker compose create *)",
      "Bash(docker compose start *)",
      "Bash(docker compose stop *)",
      "Bash(docker compose restart *)",
      "Bash(docker compose rm *)",
      "Bash(docker compose kill *)",
      "Bash(docker compose pull *)",
      "Bash(docker compose push *)",
      "Bash(docker compose watch *)",
      "Bash(docker-compose *)",
      "Bash(chmod *)"
    ],
    "defaultMode": "auto",
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|idle_prompt|agent_needs_input|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-notify.sh 'Claude Code has questions' 'main'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "elicitation_dialog|elicitation_url_dialog|agent_needs_input",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion|ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh waiting",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh none",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh none",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh none",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-notify.sh 'Claude Code is free now' 'main'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh done",
            "timeout": 5
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh done",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh none --force",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/wezterm-state.sh none --force",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "language": "japanese",
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "network": {
      "allowedDomains": [
        "github.com",
        "raw.githubusercontent.com",
        "objects.githubusercontent.com",
        "registry.npmjs.org",
        "proxy.golang.org",
        "sum.golang.org",
        "services.gradle.org",
        "plugins.gradle.org",
        "repo.maven.apache.org",
        "repo1.maven.org",
        "dl.google.com",
        "pypi.org",
        "files.pythonhosted.org"
      ]
    },
    "filesystem": {
      "allowWrite": [
        "~/.gradle",
        "~/Library/Caches/go-build",
        "~/go/pkg/mod",
        "~/Library/Caches/golangci-lint",
        "~/.docker/buildx",
        "~/.claude/logs"
      ]
    },
    "credentials": {
      "files": [
        {
          "path": "~/.aws/credentials",
          "mode": "deny"
        },
        {
          "path": "~/.kube/config",
          "mode": "deny"
        },
        {
          "path": "~/.local/share/deck/credentials.json",
          "mode": "deny"
        },
        {
          "path": "~/.ssh",
          "mode": "deny"
        },
        {
          "path": "~/.config/gh/hosts.yml",
          "mode": "deny"
        }
      ],
      "envVars": [
        {
          "name": "GITHUB_PAT",
          "mode": "deny"
        },
        {
          "name": "OPENAI_API_KEY",
          "mode": "deny"
        },
        {
          "name": "CODEX_API_KEY",
          "mode": "deny"
        },
        {
          "name": "CLOUDSDK_PROXY_PASSWORD",
          "mode": "deny"
        },
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        }
      ]
    },
    "excludedCommands": [
      "gh *",
      "docker *",
      "hunk session *"
    ]
  },
  "plansDirectory": "docs/plans",
  "agentPushNotifEnabled": true
}
