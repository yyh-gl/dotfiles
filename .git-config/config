[user]
  name = yyh-gl
  email = yhonda.95.gl@gmail.com

[color]
  ui = true

[alias]
  tree = log --graph --all --format=\"%x09%C(cyan bold)%an%Creset%x09%C(yellow)%h%Creset %C(magenta reverse)%d%Creset %s\"
  st = status
  co = checkout
  br = branch
  cm = commit
  df = diff
  gr = grep
  cp = cherry-pick

[core]
  editor = emacs
  # pager = less -R -F -X
  pager = delta

[pull]
  rebase = true

[init]
  defaultBranch = main

[delta]
  navigate = true
  side-by-side = true

# 署名鍵はhobbyモードでだけ1Passwordから配置する（nix/home/secrets.nix）ため、署名設定は別ファイルに分けている。
# workモードにはこのファイルを置かないので、署名なしでコミットできる（存在しないincludeは無視される）
[include]
  path = ~/.config/git/signing
  # 機械ごとの上書き用（workのuser.emailなど）。Nixでは管理しない
  path = ~/.config/git/local
