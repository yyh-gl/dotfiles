[user]
  name = yyh-gl
  email = yhonda.95.gl@gmail.com

[color]
  ui = true

[alias]
  tree = log --graph --all --format=\"%x09%C(cyan bold)%an%Creset%x09%C(yellow)%h%Creset %C(magenta reverse)%d%Creset %s\"
  st = status
  co = checkout
  br = branch
  cm = commit
  df = diff
  gr = grep
  cp = cherry-pick

[core]
  editor = emacs
  # pager = less -R -F -X
  pager = delta

[pull]
  rebase = true

[init]
  defaultBranch = main

[delta]
  navigate = true
  side-by-side = true

# pushだけSSHに振り替える
# HTTPSのままだと、sandbox内のgitがcredential helper（gh auth git-credential）経由で
# ghのトークンを借りてpushできてしまう（トークンはキーチェーンにあり、hosts.ymlのdenyでは守れない）
[url "git@github.com:"]
  pushInsteadOf = https://github.com/

# modeごとにインポートする設定を分ける
[include]
  path = ~/.config/git/signing
  # emailといったmodeごとの上書き用設定（Nixでは管理しない）
  path = ~/.config/git/local
